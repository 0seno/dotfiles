[memory]
label= 
#color=#d8dee9
color=#c9cbd1
separator=false
interval=30


[cpu_usage]
color=#c9cbd1
label=
interval=10
min_width=
separator=false

[temperature]
label=
#color=#d8dee9
color=#c9cbd1
interval=10
separator=true
min_width=te: 90.00%
# Memory usage
#
# The type defaults to "mem" if the instance is not specified.

[memory]
#label= SWAP
instance=
#separator=false
#interval=30

# Disk usage
